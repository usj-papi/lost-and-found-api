# Copy this file to .env. Never commit credentials.
PORT=3000

# Supabase: copy Connect > Session pooler URI (port 5432).
DATABASE_URI="postgresql://postgres.PROJECT_REF:ENCODED_DATABASE_PASSWORD@POOLER_HOST:5432/postgres"

# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
